# Copy to .env and adjust values as needed.
MYSQL_ROOT_PASSWORD=root
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WS_ALLOWED_ORIGINS=http://localhost:8088
# observability profile: set sampling > 0 only when an OTLP collector is running.
TRACING_SAMPLING=0.0
OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
PROMETHEUS_PUBLIC=false
