        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=\"fileMeta\",result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_gets_total{cache=\"fileMeta\"}[5m])), 0.001)",
