# TEMPLATE ONLY; never commit the populated file or put it into CI artifacts.
# Save outside the repository (e.g. /etc/cloudchunk/production.env; chmod 600).
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
WS_ALLOWED_ORIGINS=https://files.example.com
PROMETHEUS_PUBLIC=false
CROSS_USER_DEDUP_ENABLED=false
TRACING_SAMPLING=0.0

# These MUST be complete registry image references ending in @sha256:<64 hex>.
CLOUDCHUNK_API_IMAGE=
CLOUDCHUNK_WEB_IMAGE=
CC_MYSQL_IMAGE=
CC_REDIS_IMAGE=
CC_RMQ_IMAGE=
CC_RMQ_DASHBOARD_IMAGE=
CC_MINIO_IMAGE=
CC_QDRANT_IMAGE=
CC_JAEGER_IMAGE=
CC_PROMETHEUS_IMAGE=
CC_GRAFANA_IMAGE=

# Optional AI features remain off until explicitly approved.
AI_CHAT_ENABLED=false
AI_EMBEDDING_ENABLED=false
AI_QDRANT_ENABLED=false

# M3.6: scraper token is NOT an API user token and must be 32+ random bytes.
# METRICS_TOKEN_FILE is an absolute, chmod 600 host file containing the
# exact METRICS_SCRAPE_TOKEN with no newline. Never commit either value.
METRICS_SCRAPE_TOKEN=
METRICS_TOKEN_FILE=
