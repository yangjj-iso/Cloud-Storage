FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -pl cloudchunk-boot -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --uid 10001 cloudchunk
COPY --from=build /workspace/cloudchunk-boot/target/cloudchunk-boot.jar /app/cloudchunk.jar
USER 10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/cloudchunk.jar"]
