FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -pl cloudchunk-boot -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --uid 10001 --create-home cloudchunk && \
    mkdir -p /app/local-storage /app/logs && \
    chown 10001 /app/local-storage /app/logs
COPY --from=build /workspace/cloudchunk-boot/target/cloudchunk-boot.jar /app/cloudchunk.jar
USER 10001
RUN test -w /app/logs && test -w /app/local-storage && \
    test -w /home/cloudchunk && test ! -w /app/cloudchunk.jar
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/cloudchunk.jar"]
